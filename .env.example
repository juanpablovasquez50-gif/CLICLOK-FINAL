# Supabase project settings. The anon key is public and safe to expose in a browser
# when every exposed table has correct Row Level Security policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The API server uses the same public project settings and forwards the user's
# bearer token so Postgres Row Level Security remains authoritative.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional comma-separated allowed origins for the API server.
CORS_ORIGINS=

# SESSION_SECRET is already provided by Replit Secrets in this workspace.
